  "fixed_sql": [
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"color_argb\" INTEGER NOT NULL, \"icon_name\" TEXT NOT NULL, \"reminder_minute_of_day\" INTEGER NULL CHECK(\"reminder_minute_of_day\" BETWEEN 0 AND 1439), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"scheduled_weekday_mask\" INTEGER NOT NULL DEFAULT 127 CHECK(\"scheduled_weekday_mask\" BETWEEN 1 AND 127), \"target_days_per_week\" INTEGER NULL CHECK(\"target_days_per_week\" BETWEEN 1 AND 7), \"archived_at\" INTEGER NULL, \"rest_days_per_week\" INTEGER NOT NULL DEFAULT 0 CHECK(\"rest_days_per_week\" BETWEEN 0 AND 2));"
        }
      ]
    },
    {
      "name": "objectives",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"objectives\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"habit_id\" INTEGER NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"color_argb\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL, \"counts_as_success\" INTEGER NOT NULL DEFAULT 1 CHECK (\"counts_as_success\" IN (0, 1)), UNIQUE (\"habit_id\", \"title\"));"
        }
      ]
    },
    {
      "name": "habit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"habit_id\" INTEGER NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"objective_id\" INTEGER NOT NULL REFERENCES objectives (id) ON DELETE CASCADE, \"day\" INTEGER NOT NULL, UNIQUE (\"habit_id\", \"day\"));"
        }
      ]
    },
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"content\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "habit_pauses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habit_pauses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"habit_id\" INTEGER NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"start_day\" INTEGER NOT NULL, \"end_day\" INTEGER NULL CHECK(\"end_day\" >= \"start_day\"));"
        }
      ]
    },
    {
      "name": "habit_logs_day",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX habit_logs_day ON habit_logs (day)"
        }
      ]
    },
    {
      "name": "habit_logs_objective",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX habit_logs_objective ON habit_logs (objective_id)"
        }
      ]
    }
  ]
