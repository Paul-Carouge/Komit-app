<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: habits, notes, settings and automatic backups never go to the user's
     cloud backup, whose encryption Komit cannot verify; a cable or Wi-Fi transfer to a
     new phone still copies everything. See docs/adr/0005. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <!-- No <device-transfer> section: Android then transfers every file. -->
</data-extraction-rules>
