<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7 to 8.1 cannot tell a cloud backup from a device transfer, so nothing is
     backed up at all. Android 9 to 11 use xml-v28/backup_rules.xml. See docs/adr/0005. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
