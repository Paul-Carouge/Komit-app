<?xml version="1.0" encoding="utf-8"?>
<!-- Komit only talks to GitHub over HTTPS: refuse any cleartext connection and trust only
     the system certificate authorities, never ones the user installed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
