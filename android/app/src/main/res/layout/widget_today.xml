<?xml version="1.0" encoding="utf-8"?>
<!-- The "Today" widget. RemoteViews only inflate framework views, hence no Material components. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/widget_padding"
    android:paddingVertical="@dimen/widget_padding_vertical">

    <!-- Only "Today", Komo and a count: nothing personal beyond the habit titles below. -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_minimum_touch_target"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/widget_komo_size"
            android:layout_height="@dimen/widget_komo_size"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_komo" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_today_title"
            android:textColor="@color/widget_on_surface"
            android:textSize="@dimen/widget_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_progress_background"
            android:paddingHorizontal="@dimen/widget_gap"
            android:paddingVertical="@dimen/widget_progress_padding_vertical"
            android:textColor="@color/widget_on_accent_container"
            android:textSize="@dimen/widget_body_text_size"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/widget_gap"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="@dimen/widget_body_text_size"
        android:visibility="gone" />
</LinearLayout>
