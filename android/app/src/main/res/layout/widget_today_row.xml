<?xml version="1.0" encoding="utf-8"?>
<!-- One habit of the "Today" widget: its title, then a round button in its color. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/widget_habit_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="@dimen/widget_body_text_size" />

    <!-- 48dp target around a smaller circle, so the row stays light but easy to hit. -->
    <FrameLayout
        android:id="@+id/widget_log_button"
        android:layout_width="@dimen/widget_minimum_touch_target"
        android:layout_height="@dimen/widget_minimum_touch_target"
        android:background="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/widget_log_circle"
            android:layout_width="@dimen/widget_log_circle_size"
            android:layout_height="@dimen/widget_log_circle_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_log_ring" />

        <ImageView
            android:id="@+id/widget_log_check"
            android:layout_width="@dimen/widget_log_check_size"
            android:layout_height="@dimen/widget_log_check_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_check"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
