<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the widget follows the wallpaper's dynamic colors like the widgets around it.
     Komo stays orange (widget_komo.xml), so the widget still reads as Komit. -->
<resources>
    <color name="widget_surface">@android:color/system_neutral1_10</color>
    <color name="widget_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="widget_accent_container">@android:color/system_accent1_100</color>
    <color name="widget_on_accent_container">@android:color/system_accent1_900</color>
</resources>
