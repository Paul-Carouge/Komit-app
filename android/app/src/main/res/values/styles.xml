<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts; Flutter removes it when it draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI: the brand background avoids a white or black flash on start. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/komit_launch_background</item>
    </style>
</resources>
